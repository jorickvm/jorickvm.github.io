TRANSLATION_*.md
SCREENSHOT_*.md
INCIDENT_*.md
*_HANDOFF*.md
*_PASS*.md
*_REVIEW_20*.md
*_PLAN_20*.md
*_AUDIT_20*.md
/archive/
/translation-web/
# Note: CLAUDE.md is intentionally NOT ignored — a slim public one lives in this repo.
# The full internal CLAUDE.md lives in the private atlasdays-internal repo.

# Generated locally by check_external_sources.py; CI uploads it as an artifact.
external-source-report.json

# Local Claude Code permissions — per-machine, not shared.
.claude/settings.local.json

# Simulator raws from capture_website_screenshots.py --raw-dir. Never committed:
# a PNG in git stays in the history forever (the audit rejects stray ones).
.capture-raws/
